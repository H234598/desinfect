{
  "$id": "https://h234598.github.io/desinfect/schemas/recovery-report-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archives_valid": {
      "type": "boolean"
    },
    "catalog_valid": {
      "type": "boolean"
    },
    "checkout_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "conclusion": {
      "enum": [
        "success",
        "degraded",
        "blocked",
        "failed"
      ]
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "hashes_valid": {
      "type": "boolean"
    },
    "objects_checked": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "site_valid": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "checkout_sha",
    "created_at",
    "objects_checked",
    "hashes_valid",
    "archives_valid",
    "catalog_valid",
    "site_valid",
    "conclusion"
  ],
  "title": "Desinfect recovery report",
  "type": "object"
}
