{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h234598.github.io/desinfect/schemas/implementation-status-1.0.0.json",
  "title": "Desinfect implementation status",
  "type": "object",
  "required": ["schema_version", "repository", "source_plan_sha256", "updated_at", "summary", "work_packages"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "repository": {"const": "H234598/desinfect"}, "source_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "updated_at": {"type": "string", "format": "date-time"}, "active_pr": {"type": "object"},
    "summary": {"type": "object", "required": ["total", "offen", "in_arbeit", "im_review", "umgesetzt", "blockiert"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "work_packages": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"type": "object", "required": ["id", "title", "status"], "properties": {"id": {"type": "string", "pattern": "^P[0-9]{2}\\.[0-9]+$"}, "title": {"type": "string", "minLength": 1}, "status": {"enum": ["offen", "in_arbeit", "im_review", "umgesetzt", "blockiert"]}, "branch": {"type": "string"}, "pr_number": {"type": "integer", "minimum": 1}, "blocker": {"type": "string"}, "evidence": {"type": "object", "properties": {"merge_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "ci_runs": {"type": "array", "items": {"type": "string"}}, "tests": {"type": "array", "items": {"type": "string"}}, "accepted_at": {"type": ["string", "null"]}, "accepted_by": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}, "additionalProperties": false}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
