{
  "$id": "https://h234598.github.io/desinfect/schemas/source-manifest-1.3.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bitstream_id": {
      "pattern": "^rki-bitstream-[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "bitstream_url": {
      "format": "uri",
      "pattern": "^https://edoc\\.rki\\.de/bitstream/handle/176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?/[A-Za-z0-9._~%/-]+\\.[pP][dD][fF](?:\\?sequence=[1-9][0-9]*)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "bitstream_version": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "decision_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "oneOf": [
        {"type": "null"},
        {
          "maxLength": 512,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"},
          "pattern": "^10\\.[0-9]{4,9}/[^\\s]+$",
          "type": "string"
        }
      ]
    },
    "etag": {
      "maxLength": 500,
      "type": [
        "string",
        "null"
      ]
    },
    "handle": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
      "type": "string"
    },
    "last_modified": {
      "maxLength": 200,
      "type": [
        "string",
        "null"
      ]
    },
    "publication_date": {
      "format": "date",
      "type": "string"
    },
    "provenance_state": {
      "enum": [
        "current",
        "legacy_needs_review"
      ]
    },
    "rights": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "enum": [
              "fetch",
              "cache",
              "hash",
              "ocr",
              "extract_text",
              "thumbnail",
              "index_text",
              "publish"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "approval_key": {
          "oneOf": [
            {"type": "null"},
            {
              "additionalProperties": false,
              "properties": {
                "canonical_url": {
                  "format": "uri",
                  "pattern": "^https://edoc\\.rki\\.de/bitstream/handle/176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?/[A-Za-z0-9._~%/-]+\\.[pP][dD][fF](?:\\?sequence=[1-9][0-9]*)?$",
                  "type": "string"
                },
                "source_id": {
                  "pattern": "^rki:176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
                  "type": "string"
                },
                "source_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "version_or_bitstream": {
                  "pattern": "^rki-bitstream-[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "canonical_url",
                "version_or_bitstream",
                "source_sha256"
              ],
              "type": "object"
            }
          ]
        },
        "attribution": {
          "oneOf": [
            {"type": "null"},
            {
              "additionalProperties": false,
              "properties": {
                "attribution_parties": {
                  "items": {"minLength": 1, "type": "string"},
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "copyright_notice": {"minLength": 1, "type": "string"},
                "creators": {
                  "items": {"minLength": 1, "type": "string"},
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "current_change_notice": {"minLength": 1, "type": "string"},
                "disclaimer_notice": {"minLength": 1, "type": "string"},
                "license_notice": {"minLength": 1, "type": "string"},
                "license_url": {"format": "uri", "type": "string"},
                "origin_url": {
                  "format": "uri",
                  "pattern": "^https://edoc\\.rki\\.de/handle/176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
                  "type": "string"
                },
                "prior_change_history": {
                  "items": {"minLength": 1, "type": "string"},
                  "type": "array"
                }
              },
              "required": [
                "creators",
                "attribution_parties",
                "copyright_notice",
                "license_notice",
                "license_url",
                "disclaimer_notice",
                "origin_url",
                "prior_change_history",
                "current_change_notice"
              ],
              "type": "object"
            }
          ]
        },
        "components_state": {
          "enum": ["cleared", "unknown", "blocked"]
        },
        "mode": {
          "enum": ["remove_all", "origin_link", "source_only", "materialized"]
        },
        "basis": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "reviewed_at": {
          "oneOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_by": {
          "maxLength": 200,
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "approved",
            "metadata_only",
            "internal_only",
            "unknown",
            "takedown"
          ]
        }
      },
      "required": [
        "state",
        "mode",
        "allowed_actions",
        "components_state",
        "attribution",
        "approval_key",
        "basis",
        "reviewed_at",
        "reviewed_by"
      ],
      "type": "object"
    },
    "rights_evidence": {
      "additionalProperties": false,
      "properties": {
        "copyright_notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_url": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "open_access": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "license_url",
        "copyright_notice",
        "open_access"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.3.0"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "same_content_as": {
      "items": {
        "pattern": "^rki-bitstream-[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_id": {
      "pattern": "^rki:176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "pattern": "^https://edoc\\.rki\\.de/",
      "type": "string"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "handle",
    "version",
    "source_url",
    "title",
    "publication_date",
    "etag",
    "last_modified",
    "sha256",
    "rights",
    "provenance_state",
    "bitstream_id",
    "bitstream_url",
    "bitstream_version",
    "rights_evidence",
    "decision_sha256",
    "doi",
    "same_content_as"
  ],
  "title": "Desinfect source manifest",
  "type": "object"
}
