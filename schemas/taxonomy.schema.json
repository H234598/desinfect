{
  "$id": "https://h234598.github.io/desinfect/schemas/taxonomy-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "based_on_corpus_through_year": {
      "maximum": 9999,
      "minimum": 2020,
      "type": "integer"
    },
    "based_on_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "categories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "definition": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "dimension": {
            "pattern": "^[a-z][a-z0-9_-]{1,80}$",
            "type": "string"
          },
          "evidence_count": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]{2,100}$",
            "type": "string"
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "review_status": {
            "enum": [
              "candidate",
              "approved",
              "rejected"
            ]
          },
          "source_examples": {
            "items": {
              "maxLength": 200,
              "minLength": 3,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "dimension",
          "definition",
          "aliases",
          "evidence_count",
          "source_examples",
          "review_status"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "migrations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "proposal",
        "approved",
        "deprecated"
      ]
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "version",
    "status",
    "based_on_corpus_through_year",
    "based_on_manifest_sha256",
    "categories",
    "migrations"
  ],
  "title": "Desinfect taxonomy",
  "type": "object"
}
