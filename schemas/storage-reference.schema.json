{
  "$id": "https://h234598.github.io/desinfect/schemas/storage-reference-1.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance_state": {
            "const": "current"
          }
        },
        "required": [
          "provenance_state"
        ]
      },
      "then": {
        "properties": {
          "decision_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_id": {
            "pattern": "^rki:176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "artifact_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,200}$",
      "type": "string"
    },
    "bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "conversion_id": {
      "pattern": "^conv-[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "decision_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "document_id": {
      "pattern": "^rki-176904-[0-9]+-v[1-9][0-9]*$",
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_state": {
      "enum": [
        "current",
        "legacy_needs_review"
      ]
    },
    "public_reference": {
      "oneOf": [
        {
          "format": "uri",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "relative_path": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).{1,500}$",
      "type": "string"
    },
    "rights_state": {
      "enum": [
        "approved",
        "metadata_only",
        "internal_only",
        "unknown",
        "takedown"
      ]
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_id": {
      "pattern": "^rki:176904/[0-9]+(?:\\.(?:[2-9]|[1-9][0-9]+))?$",
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "storage_backend": {
      "enum": [
        "lfs",
        "release",
        "object"
      ]
    },
    "storage_object_id": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "repository_authorized",
        "internal",
        "restricted"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "relative_path",
    "storage_backend",
    "storage_object_id",
    "sha256",
    "bytes",
    "source_id",
    "source_sha256",
    "document_id",
    "conversion_id",
    "decision_sha256",
    "provenance_state",
    "visibility",
    "rights_state",
    "public_reference"
  ],
  "title": "Desinfect storage reference",
  "type": "object"
}
