{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h234598.github.io/desinfect/schemas/grabber-result-1.0.0.json",
  "title": "Desinfect RKI grabber result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "request",
    "started_at",
    "finished_at",
    "outcome",
    "summary",
    "affected_periods",
    "records",
    "issues"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "issues_root_handle",
        "articles_handle",
        "allowed_hosts",
        "parser_contract"
      ],
      "properties": {
        "base_url": {"const": "https://edoc.rki.de"},
        "issues_root_handle": {"pattern": "^[0-9]+/[0-9]+$", "type": "string"},
        "articles_handle": {"pattern": "^[0-9]+/[0-9]+$", "type": "string"},
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "parser_contract": {"const": "rki-edoc-html-v1"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "from_year",
        "to_year",
        "dry_run",
        "max_items",
        "force",
        "respect_robots"
      ],
      "properties": {
        "scope": {"enum": ["issues", "articles", "all"]},
        "from_year": {"type": "integer", "minimum": 1900, "maximum": 9999},
        "to_year": {"type": "integer", "minimum": 1900, "maximum": 9999},
        "dry_run": {"type": "boolean"},
        "max_items": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "force": {"type": "boolean"},
        "respect_robots": {"type": ["boolean", "null"]}
      }
    },
    "started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "finished_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "outcome": {"enum": ["success", "partial", "blocked", "failed"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "planned",
        "existing",
        "downloaded",
        "resumed",
        "without_pdf",
        "record_errors",
        "issues",
        "downloads_occurred",
        "content_changed"
      ],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "existing": {"type": "integer", "minimum": 0},
        "downloaded": {"type": "integer", "minimum": 0},
        "resumed": {"type": "integer", "minimum": 0},
        "without_pdf": {"type": "integer", "minimum": 0},
        "record_errors": {"type": "integer", "minimum": 0},
        "issues": {"type": "integer", "minimum": 0},
        "downloads_occurred": {"type": "boolean"},
        "content_changed": {"type": "boolean"}
      }
    },
    "affected_periods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "months", "years"],
      "properties": {
        "weeks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}
        },
        "months": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}
        },
        "years": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1900, "maximum": 9999}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        {"type": "string", "maxLength": 2000},
        {"type": "null"}
      ]
    },
    "nullableHash": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "nullableMd5": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        {"type": "null"}
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "uri", "copyright_notice", "open_access"],
      "properties": {
        "label": {"$ref": "#/$defs/nullableString"},
        "uri": {"$ref": "#/$defs/nullableString"},
        "copyright_notice": {"$ref": "#/$defs/nullableString"},
        "open_access": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "document_id",
        "source_id",
        "version",
        "item_handle",
        "item_url",
        "title",
        "publication_date",
        "year",
        "doi",
        "rights",
        "pdf_url",
        "source_filename",
        "relative_path",
        "state",
        "bytes",
        "md5",
        "sha256",
        "expected_md5",
        "etag",
        "last_modified",
        "error_code",
        "error_message"
      ],
      "properties": {
        "scope": {"enum": ["issues", "articles"]},
        "document_id": {"type": "string", "pattern": "^rki-[0-9]+-[0-9]+-v[0-9]+$"},
        "source_id": {"type": "string", "pattern": "^rki:[0-9]+/[0-9]+(\\.[0-9]+)?$"},
        "version": {"type": "integer", "minimum": 1},
        "item_handle": {"type": "string", "pattern": "^[0-9]+/[0-9]+(\\.[0-9]+)?$"},
        "item_url": {"type": "string", "format": "uri", "pattern": "^https://edoc\\.rki\\.de/"},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "publication_date": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "year": {
          "oneOf": [
            {"type": "integer", "minimum": 1900, "maximum": 9999},
            {"type": "null"}
          ]
        },
        "doi": {"$ref": "#/$defs/nullableString"},
        "rights": {"$ref": "#/$defs/rights"},
        "pdf_url": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://edoc\\.rki\\.de/"},
            {"type": "null"}
          ]
        },
        "source_filename": {"$ref": "#/$defs/nullableString"},
        "relative_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            {"type": "null"}
          ]
        },
        "state": {"enum": ["planned", "existing", "downloaded", "resumed", "no_pdf", "error"]},
        "bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "md5": {"$ref": "#/$defs/nullableMd5"},
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "expected_md5": {"$ref": "#/$defs/nullableMd5"},
        "etag": {"$ref": "#/$defs/nullableString"},
        "last_modified": {"$ref": "#/$defs/nullableString"},
        "error_code": {"$ref": "#/$defs/nullableString"},
        "error_message": {"$ref": "#/$defs/nullableString"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "stage", "retryable", "item_url", "pdf_url"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,120}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "retryable": {"type": "boolean"},
        "item_url": {
          "oneOf": [
            {"type": "string", "format": "uri"},
            {"type": "null"}
          ]
        },
        "pdf_url": {
          "oneOf": [
            {"type": "string", "format": "uri"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
